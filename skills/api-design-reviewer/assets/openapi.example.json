{
  "openapi": "3.0.0",
  "info": {"title": "Widget API", "version": "1.0.0"},
  "paths": {
    "/widgets": {
      "get": {
        "operationId": "listWidgets",
        "parameters": [{"name": "page", "in": "query", "schema": {"type": "integer"}}, {"name": "limit", "in": "query", "schema": {"type": "integer"}}],
        "responses": {"200": {"description": "ok"}}
      },
      "post": {
        "operationId": "createWidget",
        "responses": {"201": {"description": "created"}}
      }
    },
    "/widgets/getWidget": {
      "get": {
        "operationId": "listWidgets",
        "parameters": [{"name": "offset", "in": "query", "schema": {"type": "integer"}}, {"name": "page_size", "in": "query", "schema": {"type": "integer"}}],
        "responses": {"200": {"description": "ok", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MissingSchema"}}}}}
      }
    },
    "/widgets/{widgetId}/delete": {
      "delete": {
        "operationId": "deleteWidget",
        "responses": {"204": {"description": "deleted"}}
      }
    },
    "/widget/{widgetId}": {
      "get": {
        "operationId": "getWidget",
        "responses": {"200": {"description": "ok", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Widget"}}}}}
      }
    }
  },
  "components": {
    "schemas": {
      "Widget": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "example": "{\"widgetId\": \"abc\", }"},
          "widgetId": {"type": "string"},
          "name": {"type": "string"}
        }
      }
    }
  }
}
